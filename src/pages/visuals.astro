---
// WORK: only the studio's own projects. One project shown in depth, then films from the portfolio.
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WorkReel from "../components/WorkReel.astro";
import Tour from "../components/Tour.astro";
import TourCard from "../components/TourCard.astro";
import { tours } from "../data/tours";
import "../styles/global.css";

// VIRTUAL TOURS: every ready tour in src/data/tours.ts. The first opens as an inline viewer; the rest are cards
// that start their own viewer in place. Adding a tour is data only: drop its json and pictures, then rebuild.
const [firstTour, ...moreTours] = tours;
const tourId = (slug: string) => `tour-${slug}`;

// adu-9 to adu-11 are new camera angles rendered from the same scene (tools/render-portfolio.py)
const renders = [1, 14, 9, 15, 11, 16, 10, 13].map((n) => `adu-${n}`);
const stages = [
  { img: "svc-plan", title: "Floor plan", text: "Cut straight from the coordinated Revit model: existing house on the left, the new unit on the right." },
  { img: "svc-elevation", title: "Elevation", text: "Elevations and sections come from the same model, so they always agree with the plans." },
  { img: "svc-model", title: "3D model", text: "The existing house and the new two storey addition, modeled together." },
  { img: "svc-bim", title: "BIM detail", text: "434 model elements across architecture, structure, electrical, plumbing and ventilation." },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title="Work: Renders, Films and BIM Projects | Axys3D" description="Projects produced in house by Axys3D: Revit models, permit drawing sets, photoreal renders and walkthrough films." image="/media/adu-1.webp" />
  </head>

  <body>
    <Navbar />
    <main id="main" tabindex="-1" class="pg">
      <section class="pg-hero">
        <div class="ax-wrap">
          <h1 class="ax-display ax-h1--sm" data-ax>Our work, from model to final frame.</h1>
          <p class="ax-lead" data-ax>Everything on this page was produced in house. Client and site details are left out on purpose: we do not publish them without permission.</p>
          <div class="pg-actions" data-ax>
            <a href="/contact/" class="ax-btn ax-btn--gold">Start a project</a>
            <a href="#project" class="ax-link">See one project start to finish</a>
          </div>
        </div>
        <figure class="ax-wrap pg-hero-media" data-ax>
          <video muted playsinline loop autoplay preload="metadata" poster="/media/exterior.webp" src="/media/exterior.mp4" aria-label="Exterior film of the two storey residence"></video>
        </figure>
      </section>

      <!-- one project, start to finish -->
      <section aria-labelledby="vsProject" id="project">
        <div class="ax-wrap">
          <header class="ax-head">
            <h2 class="ax-display" id="vsProject" data-ax>Two storey residence. Revit model to final render.</h2>
            <p class="ax-lead" data-ax>A new two storey unit added to an existing house. We modeled both in Revit, produced the permit drawing set, then built the scene and rendered the exterior.</p>
            <a class="ax-link" href="/#explore" data-ax>Turn this building in 3D</a>
          </header>
          <ul class="pg-gallery">
            {renders.map((r, i) => (
              <li class:list={[i === 0 && "wide"]} data-ax style={`--ax-d:${(i % 3) * 0.06}s`}>
                <button type="button" class="vs-zoom" data-full={`/media/${r}.webp`} aria-label={`Open exterior render ${i + 1} large`}><img src={`/media/${r}.webp`} srcset={`/media/${r}-sm.webp 800w, /media/${r}.webp 1536w`} sizes={i === 0 ? "(max-width: 900px) 94vw, 820px" : "(max-width: 900px) 46vw, 400px"} width="1536" height="1024" alt={`Exterior render ${i + 1} of the two storey residence`} loading={i === 0 ? "eager" : "lazy"} decoding="async" /></button>
              </li>
            ))}
          </ul>
          <ol class="vs-stages">
            {stages.map((s, i) => (
              <li data-ax style={`--ax-d:${i * 0.07}s`}>
                <button type="button" class="vs-zoom" data-full={`/media/${s.img}.webp`} aria-label={`Open the ${s.title.toLowerCase()} large`}><img src={`/media/${s.img}.webp`} srcset={`/media/${s.img}-sm.webp 800w, /media/${s.img}.webp 1600w`} sizes="(max-width: 900px) 94vw, 400px" width="1600" height="1000" alt={`${s.title} of the residence, from the project model`} loading="lazy" decoding="async" /><span class="vs-zoom-i" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 2h4v4M6 14H2v-4M14 2L9.5 6.5M2 14l4.5-4.5" /></svg></span></button>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- virtual tours: right after the project in depth, as the next way to see our work -->
      {firstTour && (
        <div class="ax-dark vt" id="tours">
          <Tour slug={firstTour.slug} id={tourId(firstTour.slug)} heading="Walk through the rooms before they are built." lead={`${firstTour.project}. ${firstTour.summary}`} cta={false} />
          {moreTours.length > 0 && (
            <div class="ax-wrap vt-more">
              <p class="vt-more-h" data-ax>More tours</p>
              <ul class="vt-cards">
                {moreTours.map((t) => (
                  <li data-ax><TourCard tour={t} level={3} open={tourId(t.slug)} /></li>
                ))}
              </ul>
            </div>
          )}
          {moreTours.map((t) => (
            <div class="vt-slot" data-slot={tourId(t.slug)} hidden>
              <Tour slug={t.slug} id={tourId(t.slug)} heading={t.project} level={3} lead={t.summary} cta={false} />
            </div>
          ))}
          <div class="ax-wrap">
            <div class="pg-actions vt-actions" data-ax>
              <a href="/contact/" class="ax-btn ax-btn--gold">Start a project</a>
            </div>
          </div>
        </div>
      )}

      <section class="ax-section vs-films" aria-labelledby="vsFilms" id="films">
        <div class="ax-wrap">
          <header class="ax-head" style="margin-bottom:0">
            <h2 class="ax-display" id="vsFilms" data-ax>Exteriors, interiors and environments.</h2>
            <p class="ax-lead" data-ax>Frames from our films. Select any piece to watch it.</p>
          </header>
        </div>
        <WorkReel limit={9} heading={false} feature={true} />
      </section>

      <section class="pg-cta ax-dark">
        <div class="ax-wrap">
          <h2 class="ax-display" data-ax>Need something like this? Send us your drawings.</h2>
          <p class="ax-lead" data-ax>Tell us what you are working on and we will reply with a clear scope, price and timeline.</p>
          <div class="pg-actions" data-ax><a href="/contact/" class="ax-btn ax-btn--gold">Start a project</a></div>
        </div>
      </section>
    </main>
    <dialog class="vs-box ax-dark" id="vsBox" aria-label="Large view">
      <button type="button" class="vs-box-x" aria-label="Close"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
      <button type="button" class="vs-box-nav vs-box-prev" aria-label="Previous picture"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <img alt="" />
      <button type="button" class="vs-box-nav vs-box-next" aria-label="Next picture"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
      <p class="vs-box-cap" aria-live="polite"></p>
    </dialog>
    <Footer />
  </body>
</html>

<style is:global>
  .vs-zoom { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: inherit; overflow: hidden; }
  .vs-zoom img { transition: transform 1.2s var(--ax-ease); }
  .vs-zoom:hover img { transform: scale(1.04); }
  .vs-stages .vs-zoom { height: auto; border-radius: var(--ax-r-md); }
  .vs-zoom-i { position: absolute; right: 10px; top: 10px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--ax-r-chip); background: rgba(14, 16, 20, 0.7); color: #fff; }
  .vs-box { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: clamp(12px, 3vw, 40px); border: 0; background: rgba(8, 9, 11, 0.94); }
  .vs-box[open] { display: grid; place-items: center; }
  .vs-box::backdrop { background: rgba(8, 9, 11, 0.6); }
  .vs-box img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: var(--ax-r-media); }
  .vs-box-x { position: absolute; right: clamp(10px, 2vw, 24px); top: clamp(10px, 2vw, 24px); z-index: 1; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--ax-r-btn-sm); background: rgba(255, 255, 255, 0.14); color: #fff; }
  .vs-box-x:hover { background: rgba(255, 255, 255, 0.26); }
  .vs-box-nav { position: absolute; top: 50%; z-index: 1; display: grid; place-items: center; width: 48px; height: 48px; margin-top: -24px; border-radius: var(--ax-r-btn-sm); background: rgba(14, 16, 20, 0.7); color: #fff; }
  .vs-box-nav:hover { background: rgba(255, 255, 255, 0.26); }
  .vs-box-prev { left: clamp(8px, 2vw, 24px); } .vs-box-next { right: clamp(8px, 2vw, 24px); }
  .vs-box-cap { position: absolute; left: 0; right: 0; bottom: clamp(10px, 2vw, 22px); margin: 0; text-align: center; font-size: 14px; font-weight: 600; color: rgba(255, 255, 255, 0.8); }
  .vs-stages { list-style: none; margin: clamp(28px, 4vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px); }
  .vs-stages img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--ax-r-md); background: #0d0d0c; }
  .vs-stages h3 { margin: 18px 0 8px; }
  .vs-stages p { margin: 0; font-size: 15.5px; line-height: 1.55; color: var(--ax-text-2); }
  /* virtual tours: one dark band; the Tour sections inside it share its padding */
  .vt { padding-block: var(--ax-section); }
  .vt .tour { padding-block: 0; }
  .vt-more { margin-top: clamp(48px, 6vw, 96px); }
  .vt-more-h { margin: 0 0 clamp(16px, 2vw, 24px); font-size: 15px; font-weight: 600; color: var(--ax-text-3); }
  .vt-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 4vw, 56px) clamp(16px, 2.4vw, 32px); }
  .vt-slot { margin-top: clamp(48px, 6vw, 96px); }
  .vt-actions { margin-top: clamp(32px, 4vw, 56px); }
  @media (max-width: 760px) { .vt-cards { grid-template-columns: 1fr; } }
  .vs-films .wr { padding-top: clamp(32px, 4vw, 56px); padding-bottom: 0; }
  @media (max-width: 1000px) { .vs-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .vs-stages { grid-template-columns: 1fr; } }
</style>

<script>
  // a tour card reveals its own viewer before Tour.astro's data-tour-open hook scrolls to it and starts it
  // (capture phase, so this runs first); a hidden viewer has loaded nothing, not even its poster
  document.addEventListener("click", (e) => {
    const b = (e.target as Element | null)?.closest<HTMLElement>(".vt [data-tour-open]");
    if (!b) return;
    const slot = document.querySelector<HTMLElement>(`.vt-slot[data-slot="${b.dataset.tourOpen}"]`);
    if (slot) slot.hidden = false;
    b.setAttribute("aria-expanded", "true");
  }, true);

  const box =document.getElementById("vsBox") as HTMLDialogElement | null;
  if (box) {
    const img = box.querySelector("img")!;
    const cap = box.querySelector<HTMLElement>(".vs-box-cap")!;
    const items = Array.from(document.querySelectorAll<HTMLButtonElement>(".vs-zoom"));
    let at = 0;
    const show = (i: number) => {
      at = (i + items.length) % items.length;
      const b = items[at];
      img.src = b.dataset.full!;
      img.alt = b.querySelector("img")?.alt ?? "";
      cap.textContent = `${at + 1} of ${items.length}`;
    };
    items.forEach((b, i) => b.addEventListener("click", () => { show(i); box.showModal(); }));
    box.querySelector(".vs-box-x")!.addEventListener("click", () => box.close());
    box.querySelector(".vs-box-prev")!.addEventListener("click", () => show(at - 1));
    box.querySelector(".vs-box-next")!.addEventListener("click", () => show(at + 1));
    box.addEventListener("click", (e) => { if (e.target === box) box.close(); });
    box.addEventListener("keydown", (e) => { if (e.key === "ArrowRight") show(at + 1); if (e.key === "ArrowLeft") show(at - 1); });
    box.addEventListener("close", () => items[at]?.focus({ preventScroll: true }));
  }
</script>
